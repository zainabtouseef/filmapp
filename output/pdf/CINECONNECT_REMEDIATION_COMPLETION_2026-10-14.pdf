stream
{
  "release": "2026.10.14-audit2",
  "domain": "https://cine.nalexustechnologies.com",
  "date": "2026-10-14",
  "findings": [
    {
      "id": "F01",
      "severity": "High",
      "title": "Signup phone OTP is a local length check",
      "area": "Authentication",
      "kind": "Simulated verification",
      "observed": "After real registration, Verify Your Phone claims a code was sent. _verifyOtp only checks that trimmed input has six characters; it makes no verification request. Resend only restarts a timer. A local backend check issued an access token on registration without an OTP challenge.",
      "impact": "The phone-verification ceremony does not establish ownership of a phone number. Registration itself is backend-connected; the displayed verification step is not.",
      "fix": "Implement a server-owned challenge, provider delivery, expiry, attempt limits and phone_verified_at transition, or remove the unsupported verification step.",
      "accept": "Wrong, expired and reused codes fail; resend contacts the challenge API; no verified-phone state is shown before a successful server response.",
      "evidence": [
        [
          "lib/core/core_ui/screens/auth_screens.dart",
          226,
          269
        ],
        [
          "lib/core/core_ui/screens/auth_screens.dart",
          430,
          453
        ],
        [
          "backend/app/api/auth.py",
          208,
          275
        ]
      ],
      "status": "CAPABILITY LIMITED",
      "resolution": "Removed the fake OTP and resend steps. Signup saves the phone number without claiming ownership verification. SMS OTP remains unavailable because no SMS provider is configured.",
      "validation": "auth_screens.dart; api/auth.py; registration regression"
    },
    {
      "id": "F02",
      "severity": "High",
      "title": "File worker declares files clean without scanning",
      "area": "Uploads and verification",
      "kind": "Backend simulation",
      "observed": "scan_completed_file calls mark_file_scan_clean, which changes pending rows to clean/ready without reading the object or invoking a malware scanner. In an isolated database, a FileAsset referring to a nonexistent object became clean and ready.",
      "impact": "Upload status can imply security scanning that has not occurred. The upload API does require received bytes before completion; this finding concerns the later worker stage.",
      "fix": "Verify the stored object and digest, invoke the selected scanner, implement failure/quarantine states, and publish ready only after required processing succeeds.",
      "accept": "Missing, mismatched and scanner-rejected objects never become ready; clean results include a real scanner result and retry behavior.",
      "evidence": [
        [
          "backend/app/services/file_processing.py",
          11,
          43
        ],
        [
          "backend/app/tasks/files.py",
          10,
          17
        ],
        [
          "backend/app/api/verification.py",
          398,
          452
        ]
      ],
      "status": "FIXED",
      "resolution": "Installed ClamAV on loopback. Workers verify stored length and SHA-256, scan real bytes, quarantine infections and retry scanner failures. Public media now passes the API scan gate. Rescanned all existing records.",
      "validation": "services/file_processing.py; api/verification.py; live clean/EICAR checks"
    },
    {
      "id": "F03",
      "severity": "High",
      "title": "Test payout accounts are accepted as verified in production mode",
      "area": "Equipment, location and payments",
      "kind": "Backend-connected sandbox",
      "observed": "Both earnings screens offer Add test payout account. The controller submits provider=sandbox and a constant sandbox token. The API accepts sandbox and assigns verified without an APP_ENV guard. The isolated production-mode endpoint check returned HTTP 201 with status verified.",
      "impact": "A verified payout record can represent a fixture rather than a verified bank or wallet destination. This check did not transfer money or modify production.",
      "fix": "Remove test-account entry points from real portal flows and reject sandbox payout providers server-side in production. Route users to the real pending-verification account form.",
      "accept": "Production rejects sandbox payout creation; real account identifiers remain pending until the intended verification process completes.",
      "evidence": [
        [
          "lib/core/payments/payments_controller.dart",
          73,
          81
        ],
        [
          "lib/features/location_owner/screens/lo09_earnings_deposits_screen.dart",
          233,
          243
        ],
        [
          "lib/features/media_equipment/screens/me10_earnings_ratings_screen.dart",
          273,
          279
        ],
        [
          "backend/app/api/payments.py",
          503,
          535
        ]
      ],
      "status": "FIXED",
      "resolution": "Production rejects sandbox payout accounts. Removed test-account creation buttons and replaced them with real account management. Submitted bank accounts remain pending manual verification.",
      "validation": "api/payments.py; lo09/me10 screens; production payout regression"
    },
    {
      "id": "F04",
      "severity": "High",
      "title": "Reachable legacy dashboard displays fixed talent business data",
      "area": "Shared legacy dashboard",
      "kind": "Runtime hardcoded records",
      "observed": "/portal/dashboard resolves to DashboardScreen and is available to active signed-in accounts through the shared-account guard. Its featured card and carousel use TalentData constants: fixed names, PKR 10,000-15,000 rates, 4.5-4.9 ratings, and default verified/available flags. It also uses a bundled current-user avatar and fixed showreel duration.",
      "impact": "An authenticated route mixes real dashboard KPIs with fabricated discovery records, creating an inconsistent source of truth.",
      "fix": "Retire the route or redirect it to the shared live marketplace. If retained, replace every TalentData business value with API results and explicit empty/error states.",
      "accept": "Changing or deleting server listings changes this page; offline errors never reveal fixture talent, prices, verification or availability.",
      "evidence": [
        [
          "lib/core/core_ui/core_routes.dart",
          103,
          103
        ],
        [
          "lib/core/core_ui/core_routes.dart",
          406,
          407
        ],
        [
          "lib/core/auth/portal_access_guard.dart",
          37,
          53
        ],
        [
          "lib/screens/dashboard_screen.dart",
          59,
          95
        ],
        [
          "lib/models/talent.dart",
          16,
          75
        ]
      ],
      "status": "FIXED",
      "resolution": "The legacy dashboard route now opens the API-backed marketplace. Removed the fixed talent fixture catalogue from the reachable dashboard path.",
      "validation": "core_routes.dart; dashboard_screen.dart; models/talent.dart"
    },
    {
      "id": "F05",
      "severity": "High",
      "title": "Booking review terms are omitted from submitted API data",
      "area": "Director and public-buyer booking",
      "kind": "Partial backend connection",
      "observed": "The review step displays payment percentages, deliverables, usage rights, expiry and category-specific inputs. _send passes project/listing/requirement IDs, dates, fee, currency and _conditions only. The repository create/send bodies have no fields for the other reviewed terms.",
