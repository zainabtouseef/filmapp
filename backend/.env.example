APP_ENV=development
SECRET_KEY=replace-with-at-least-64-random-characters
JWT_SECRET_KEY=replace-with-a-separate-64-character-random-secret
FIELD_ENCRYPTION_KEY=replace-with-a-fernet-key

DATABASE_URL=mysql+pymysql://cineconnect:local-only-password@mysql:3306/cineconnect?charset=utf8mb4
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

PUBLIC_WEB_ORIGIN=http://localhost:3000
API_PUBLIC_URL=http://localhost:5000
CORS_ALLOWED_ORIGINS=http://localhost:3000

PAYMENT_MODE=sandbox
